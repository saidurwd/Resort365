# Resort365 production settings (Step 7.5, docs/OPERATIONS.md). Copy to the server's shared/.env and fill in every <...>.
# The app refuses to boot in production with APP_DEBUG=true.
APP_NAME=Resort365
APP_ENV=production
APP_KEY=<php artisan key:generate --show; never change it once data exists: encrypted fields depend on it>
APP_DEBUG=false
APP_URL=https://resort365.app
TENANCY_CENTRAL_DOMAIN=resort365.app
TENANCY_TRIAL_DAYS=14

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Logs as JSON lines for the server's log shipper; errors also go to Sentry.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resort365
DB_USERNAME=resort365
DB_PASSWORD=<strong password>

# Sessions: Redis, secure cookies on HTTPS only, not readable by scripts, not sent on cross-site requests.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<redis password>
REDIS_PORT=6379

# Files: S3-compatible storage, private bucket with versioning on.
FILESYSTEM_DISK=local
ATTACHMENTS_DISK=s3
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_DEFAULT_REGION=<region>
AWS_BUCKET=<attachments bucket>
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup): their own bucket, encrypted archives, a mail when one fails or is too old.
BACKUP_DISKS=backups-s3
BACKUP_AWS_ACCESS_KEY_ID=<key>
BACKUP_AWS_SECRET_ACCESS_KEY=<secret>
BACKUP_AWS_DEFAULT_REGION=<region>
BACKUP_AWS_BUCKET=<backup bucket>
BACKUP_AWS_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=<long random password, kept in the password manager too>
BACKUP_NOTIFY_EMAIL=<ops mailbox>

# Real time: Reverb behind Nginx (deploy/nginx.conf proxies /app to 127.0.0.1:8080).
REVERB_APP_ID=resort365
REVERB_APP_KEY=<random>
REVERB_APP_SECRET=<random>
REVERB_HOST=resort365.app
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<user>
MAIL_PASSWORD=<password>
MAIL_FROM_ADDRESS="no-reply@resort365.app"
MAIL_FROM_NAME="${APP_NAME}"

# Monitoring: Sentry for errors (no personal data is sent), Pulse and Horizon at /platform/pulse and /platform/horizon.
SENTRY_LARAVEL_DSN=<dsn from sentry.io>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
