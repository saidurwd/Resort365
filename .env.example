APP_NAME=Resort365
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Central domain. Tenants live on subdomains of it (e.g. rodela.resort365.test).
APP_URL=http://resort365.test
TENANCY_CENTRAL_DOMAIN=resort365.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: MariaDB (Homebrew). CI and production: MySQL 8.4. Keep the mysql driver so both use the same grammar.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resort365
DB_USERNAME=resort365
DB_PASSWORD=secret

SESSION_DRIVER=redis
# Idle timeout in minutes: a session ends after this long without a request (ARCHITECTURE §9.1).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Attachments: `attachments` (private local disk) or `s3` (S3-compatible; set the AWS_* values below).
ATTACHMENTS_DISK=attachments
QUEUE_CONNECTION=redis

# Real-time (Step 3.5): Laravel Reverb. Run the server with `php artisan reverb:start` (included in `composer dev`).
# Broadcasts are queued, so a queue worker must run too. Screens fall back to polling every 5 s without it.
REVERB_APP_ID=resort365
REVERB_APP_KEY=resort365-local-key
REVERB_APP_SECRET=resort365-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: `log` locally (messages go to storage/logs/laravel.log); smtp, ses or mailgun in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@resort365.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
