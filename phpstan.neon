includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - Modules
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    excludePaths:
        # Dusk journeys call the DuskTestCase helpers on Pest's bound $this, which PHPStan cannot see (Step 7.6). The base class
        # tests/DuskTestCase.php is still analysed.
        - tests/Browser
